{
  "includeCoAuthoredBy": true,
  "permissions": {
    "deny": [
      "Bash(cargo*)",
      "Bash(npx playwright*)",
      "Bash(playwright test*)",
      "Bash(playwright-cli*)",
      "mcp__plugin_sentry_sentry__search_issues",
      "mcp__plugin_sentry_sentry__search_events",
      "mcp__plugin_sentry_sentry__find_projects"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/guard_commands.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE_PATH=$(jq -r '.tool_input.file_path // empty') && echo \"$FILE_PATH\" | grep -q 'apps/api/' && docker compose -f apps/compose.yml run --rm api cargo clippy --fix --allow-dirty --allow-staged || true",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/plan-preview.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true,
    "sentry@claude-plugins-official": true
  },
  "plansDirectory": "$CLAUDE_PROJECT_DIR/.claude/plans"
}
