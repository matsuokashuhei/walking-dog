{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch: walking-dog",
      "type": "shell",
      "command": "cargo watch -x 'run --bin walking-dog'",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "watch: track_point_worker",
      "type": "shell",
      "command": "cargo watch -x 'run --bin track_point_worker'",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "watch: all",
      "dependsOn": ["watch: walking-dog", "watch: track_point_worker"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "watch: docker compose up",
      "type": "shell",
      "command": "docker compose -f apps/compose.yml up",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
