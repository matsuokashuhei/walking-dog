{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: architecture check",
      "type": "shell",
      "command": "cargo xtask architecture check",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "problemMatcher": []
    },
    {
      "label": "api: verify image catalog",
      "type": "shell",
      "command": "cargo xtask image-catalog verify",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "problemMatcher": []
    },
    {
      "label": "api: run",
      "type": "shell",
      "command": "cargo run -p api-bootstrap --bin api",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "api: worker",
      "type": "shell",
      "command": "cargo run -p api-bootstrap --bin track-point-worker",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "api: integration tests",
      "type": "shell",
      "command": "cargo test --workspace --all-targets --all-features --locked",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "problemMatcher": []
    }
  ]
}
