{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --host lan",
    "metro:kill": "sh ./scripts/kill-metro.sh",
    "ios:clean": "npx expo prebuild --platform ios --clean",
    "ios:sim:local": "EXPO_PUBLIC_API_URL=http://localhost:3000 expo run:ios --device",
    "ios:sim:dev": "EXPO_PUBLIC_API_URL=https://walkingdogdev.dpdns.org expo run:ios",
    "ios:sim:prod": "EXPO_PUBLIC_API_URL=https://walkingdogdev.dpdns.org expo run:ios --configuration Release",
    "ios:dev:local": "EXPO_PUBLIC_API_URL=http://localhost:3000 expo run:ios --device",
    "ios:dev:dev": "EXPO_PUBLIC_API_URL=https://walkingdogdev.dpdns.org expo run:ios --device --configuration Release",
    "ios:dev:prod": "EXPO_PUBLIC_API_URL=https://walkingdogdev.dpdns.org expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@bacons/apple-targets": "4.0.6",
    "@effect/platform": "0.96.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.91.3",
    "effect": "3.21.2",
    "expo": "~55.0.17",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.28",
    "expo-file-system": "55.0.17",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.13",
    "expo-location": "~55.1.8",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "graffle": "8.0.0-next.223",
    "graphql": "^16.13.1",
    "i18next": "^25.10.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.6.1",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "coverageReporters": [
      "json-summary",
      "text"
    ]
  },
  "private": true,
  "knip": {
    "ignoreFiles": [
      ".claude/skills/**",
      "components/ui/icon-symbol.ios.tsx",
      "hooks/use-color-scheme.web.ts",
      "targets/walk-live-activity/expo-target.config.js"
    ],
    "ignoreIssues": {
      "modules/walk-activity/index.ts": [
        "exports"
      ]
    }
  }
}
