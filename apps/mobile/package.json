{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --host lan",
    "metro:kill": "sh ./scripts/kill-metro.sh",
    "ios:clean": "npx expo prebuild --platform ios --clean",
    "ios:sim:local": "EXPO_PUBLIC_API_URL=http://localhost:3000 expo run:ios --device 'iPhone 17 Pro'",
    "ios:sim:clean:local": "npm run metro:kill && npm run ios:clean && npm run ios:sim:local",
    "ios:sim:dev": "EXPO_PUBLIC_API_URL=https://walking-dog.cacheandbuffer.com expo run:ios",
    "ios:sim:prod": "EXPO_PUBLIC_API_URL=https://walking-dog.cacheandbuffer.com expo run:ios --configuration Release",
    "watch:sim": "node ./scripts/run-watch-sim.mjs",
    "watch:dev": "node ./scripts/install-watch-device.cjs",
    "ios:dev:local": "EXPO_PUBLIC_API_URL=http://localhost:3000 node ./scripts/expo-run-ios-with-provisioning.cjs run:ios --device",
    "ios:dev:dev": "EXPO_PUBLIC_API_URL=https://walking-dog.cacheandbuffer.com node ./scripts/expo-run-ios-with-provisioning.cjs run:ios --device --configuration Release",
    "ios:dev:prod": "EXPO_PUBLIC_API_URL=https://walking-dog.cacheandbuffer.com node ./scripts/expo-run-ios-with-provisioning.cjs run:ios --device --configuration Release",
    "web": "expo start --web",
    "lint": "eslint \"**/*.{ts,tsx}\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"jest.setup.ts\" --ignore-pattern \".claude/**\" --ignore-pattern \"node_modules/**\" --no-error-on-unmatched-pattern",
    "knip": "knip",
    "hooks:install": "git -C ../.. config core.hooksPath .githooks",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand --forceExit --coverageReporters=lcov --coverageReporters=json-summary --coverageReporters=text",
    "test:watch": "jest --watch",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@effect/platform": "0.96.1",
    "@expo/ui": "~56.0.13",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.91.3",
    "effect": "3.21.2",
    "expo": "^56.0.16",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.6",
    "expo-constants": "~56.0.15",
    "expo-dev-client": "~57.0.7",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.5",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.5",
    "expo-web-browser": "~57.0.1",
    "expo-widgets": "~57.0.6",
    "graffle": "8.0.0-next.223",
    "graphql": "^16.13.1",
    "i18next": "^26.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~3.0.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.4.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.9.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@bacons/apple-targets": "4.0.7",
    "@expo/prebuild-config": "56.0.14",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "25.9.1",
    "@types/react": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-plugin-i18next": "6.1.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.4",
    "knip": "6.24.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "coverageReporters": [
      "json-summary",
      "text"
    ]
  },
  "private": true
}
