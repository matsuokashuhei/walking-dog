{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --host lan",
    "metro:kill": "sh ./scripts/kill-metro.sh",
    "ios:clean": "npx expo prebuild --platform ios --clean",
    "ios:sim:local": "EXPO_PUBLIC_API_URL=http://localhost:3000 expo run:ios --device 'iPhone 17 Pro'",
    "ios:sim:dev": "EXPO_PUBLIC_API_URL=https://walkingdogdev.dpdns.org expo run:ios",
    "ios:sim:prod": "EXPO_PUBLIC_API_URL=https://walkingdogdev.dpdns.org expo run:ios --configuration Release",
    "ios:dev:local": "EXPO_PUBLIC_API_URL=http://localhost:3000 expo run:ios --device",
    "ios:dev:dev": "EXPO_PUBLIC_API_URL=https://walkingdogdev.dpdns.org expo run:ios --device --configuration Release",
    "ios:dev:prod": "EXPO_PUBLIC_API_URL=https://walkingdogdev.dpdns.org expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@effect/platform": "0.96.1",
    "@expo/ui": "~56.0.13",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "3.1.0",
    "@tanstack/react-query": "^5.91.3",
    "effect": "3.21.2",
    "expo": "^56.0.0",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.14",
    "expo-constants": "~56.0.15",
    "expo-dev-client": "~56.0.15",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-picker": "~56.0.13",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.13",
    "expo-router": "~56.2.6",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "expo-widgets": "~56.0.14",
    "graffle": "8.0.0-next.223",
    "graphql": "^16.13.1",
    "i18next": "^25.10.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.6.1",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "25.5.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "coverageReporters": [
      "json-summary",
      "text"
    ]
  },
  "private": true,
  "knip": {
    "ignoreFiles": [
      ".claude/skills/**",
      "components/ui/icon-symbol.ios.tsx",
      "hooks/use-color-scheme.web.ts"
    ]
  }
}
