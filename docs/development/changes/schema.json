{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walking-dog.local/schemas/change-manifest.json",
  "title": "Walking Dog active change manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "change", "ownership", "tasks", "milestones"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "base", "singleResponsibility", "nonTargets", "noAffectedJourney", "rollback", "sameCauseFailureThreshold"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "base": { "type": "string", "minLength": 1 },
        "singleResponsibility": { "type": "string", "minLength": 1 },
        "nonTargets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "noAffectedJourney": { "type": "boolean" },
        "rollback": { "type": "string", "minLength": 1 },
        "sameCauseFailureThreshold": { "const": 3 }
      }
    },
    "ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "task"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "task": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "model", "thinking", "threadId", "owner", "responsibility", "dependencies", "acceptance", "consumers", "enforcement", "rollback"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["planner", "integration", "inventory", "implementation", "final-review"] },
          "model": { "enum": ["luna", "terra", "sol"] },
          "thinking": { "enum": ["low", "medium", "high"] },
          "threadId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "owner": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "responsibility": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "independentOf": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "required"],
            "properties": {
              "channel": { "const": "pr-body-or-ci" },
              "required": { "type": "array", "minItems": 2, "items": { "type": "string" } }
            }
          },
          "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "disposition", "decision"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "disposition": { "enum": ["updated", "checked", "not-applicable"] },
                "decision": { "type": "string", "minLength": 1 }
              }
            }
          },
          "enforcement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "rejectedSimplerAlternatives"],
            "properties": {
              "layer": { "enum": ["documentation", "schema", "cargo-policy", "clippy", "syntax-local-ast", "codegen", "ci"] },
              "rejectedSimplerAlternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "rollback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "commands", "result"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "state": { "enum": ["planned", "red", "green", "frozen"] },
          "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "result": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
